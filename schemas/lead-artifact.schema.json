{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yare.dev/schemas/lead-artifact.schema.json",
  "title": "Yare Lead Artifact",
  "description": "Portable input artifact for Yare AI Work Lead compile.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "tool",
    "task",
    "timestamp",
    "claims",
    "decisions",
    "files_touched",
    "open_loops",
    "contradictions",
    "human_approval_items",
    "verification_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "lead-artifact.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "verification_status": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string"
              },
              "verification_status": {
                "type": "string"
              },
              "requires_human_approval": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "files_touched": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_loops": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "loop": {
                "type": "string",
                "minLength": 1
              },
              "item": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_approval_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "unknown",
        "needs_human_approval",
        "contradicted",
        "partial",
        "pending",
        "failed",
        "pass",
        "fail"
      ]
    },
    "context_bundle_hash": {
      "type": "string",
      "minLength": 1
    },
    "receipt_hash": {
      "type": "string",
      "minLength": 1
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "git_state": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "untracked_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
