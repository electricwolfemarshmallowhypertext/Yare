{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yare.dev/schemas/lead-artifact.schema.json",
  "title": "Yare Lead Artifact",
  "description": "Portable input artifact for Yare AI Work Lead compile.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "tool",
    "task",
    "timestamp",
    "claims",
    "decisions",
    "files_touched",
    "open_loops",
    "contradictions",
    "human_approval_items",
    "verification_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "lead-artifact.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "verification_status": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "description": "Key of a supporting record in the artifact evidence object."
              },
              "evidence": {
                "$ref": "#/$defs/claimEvidence"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string"
              },
              "verification_status": {
                "type": "string"
              },
              "requires_human_approval": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "files_touched": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_loops": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "loop": {
                "type": "string",
                "minLength": 1
              },
              "item": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_approval_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "unknown",
        "needs_human_approval",
        "contradicted",
        "partial",
        "pending",
        "failed",
        "pass",
        "fail"
      ]
    },
    "evidence": {
      "type": "object",
      "description": "Named test or human-review records; evidence_ref resolves a record. Additional producer metadata is allowed.",
      "properties": {
        "test_run": {"$ref": "#/$defs/testEvidence"},
        "test_claim": {"$ref": "#/$defs/testEvidence"}
      },
      "additionalProperties": true
    },
    "context_bundle_hash": {
      "type": "string",
      "minLength": 1
    },
    "receipt_hash": {
      "type": "string",
      "minLength": 1
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "git_state": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "untracked_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "testEvidence": {
      "type": "object",
      "required": ["kind", "claim", "command", "exit_code", "expected_exit_code"],
      "properties": {
        "kind": {"const": "test"},
        "claim": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exit_code": {"type": "integer"},
        "expected_exit_code": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      },
      "anyOf": [{"required": ["stdout"]}, {"required": ["stderr"]}],
      "additionalProperties": true
    },
    "humanReviewEvidence": {
      "type": "object",
      "required": ["kind", "claim", "decision", "reviewer"],
      "properties": {
        "kind": {"const": "human_review"},
        "claim": {"type": "string", "minLength": 1},
        "decision": {"enum": ["approved", "rejected"]},
        "reviewer": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "claimEvidence": {
      "oneOf": [{"$ref": "#/$defs/testEvidence"}, {"$ref": "#/$defs/humanReviewEvidence"}]
    }
  },
  "additionalProperties": true
}
