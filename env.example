# Core
ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Limits / timeouts
REQUEST_MAX_BYTES=10485760
READ_TIMEOUT=30
WRITE_TIMEOUT=30
KEEPALIVE_TIMEOUT=30

# Storage
SQLITE_PATH=./data/memory/fallback.db
SQLITE_VACUUM_THRESHOLD=104857600

# Redis
REDIS_URL=redis://localhost:6379/0

# Metrics/Tracing
METRICS_PORT=9090
OTLP_ENDPOINT=

# Security
# Use *_FILE for secrets in production
API_KEYS=
# or: API_KEYS_FILE=/run/secrets/api_keys
ENCRYPTION_KEY_PATH=

# CORS / ingress
ALLOWED_ORIGINS=*
TRUSTED_HOSTS=*
PROXY_COUNT=1